
# ── Order notifications (leave blank until the owner configures them) ─────
# Telegram needs a bot token and a chat ID; plain phone numbers are not valid
# Telegram destinations. A future admin form can only expose public links.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp order recipients are live numbers that must remain server-side only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_RECIPIENTS=01100374039,01007906629

# TODO: add outbound email configuration during the next task; keep it disabled
# until the provider, credentials, and delivery flow are confirmed.
# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ── Database driver ────────────────────────────────────────────────────────
# Wardity uses MySQL for local and production runs.
DB_DRIVER=mysql
UPLOADS_DIR=./uploads

# ── MySQL (used when DB_DRIVER=mysql) ─────────────────────────────────────
# All five variables below are REQUIRED when DB_DRIVER=mysql.
# Import the wardity_import_nofk_20261016 dump into your local MySQL server
# first, then point these variables at that database.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
# Set this only in your local, ignored .env file. Never commit a real password.
MYSQL_PASSWORD=root
MYSQL_DATABASE=wardity_import_nofk_20261016

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Marketing tracking (leave blank to disable) ────────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=v21.0
META_TEST_EVENT_CODE=
