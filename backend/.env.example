
# Server Configuration
PORT=3001
ADMIN_PATH=vdminnnboohgam
NODE_ENV=production
REQUEST_BODY_LIMIT=100kb

# JWT Configuration
JWT_SECRET=<generate-a-random-32-byte-secret>
JWT_EXPIRES_IN=7d
TRUST_PROXY=false

# ── Database driver ────────────────────────────────────────────────────────
# Wardity uses MySQL for local and production runs.
DB_DRIVER=mysql
UPLOADS_DIR=./uploads
CONTACT_SETTINGS_PATH=config/contact-settings.json
WHATSAPP_API_BASE_URL=https://graph.facebook.com
PRODUCTS_DEFAULT_PAGE_SIZE=20

# ── MySQL (used when DB_DRIVER=mysql) ─────────────────────────────────────
# All five variables below are REQUIRED when DB_DRIVER=mysql.
# Create the database and application user, then restore an approved Wardity
# backup or run the reviewed initial data setup before starting the service.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=wardity_import_nofk_20261016
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=0
MYSQL_TIMEZONE=Z

# ── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
#your ip

# ── Optional order notifications ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_RECIPIENTS=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_TEMPLATE_NAME=new_order_alert_ar
WHATSAPP_TEMPLATE_LANG=ar
ORDER_NOTIFICATION_TIMEOUT_MS=5000

# ── Marketing tracking (leave blank to disable) ────────────────────────────
META_PIXEL_ID=
META_CAPI_TOKEN=
META_GRAPH_VERSION=v26.0
META_TEST_EVENT_CODE=
META_CAPI_TIMEOUT_MS=3000
META_GRAPH_BASE_URL=https://graph.facebook.com
